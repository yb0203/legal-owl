# Legal Owl web app — runtime env template.
# Copy to `apps/web/.env.local` (gitignored) and fill real values.
# Only NEXT_PUBLIC_* values reach the browser — never put secret/admin keys here.

# Supabase (browser client): Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # publishable/anon key (safe for the browser)

# Canonical app origin — used to build auth redirect links (password reset → /auth/callback).
# Falls back to request headers if unset; set it explicitly in production (your Vercel URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Outbound email (server actions). Same Resend key as root .env is fine for now.
RESEND_API_KEY=re_...
