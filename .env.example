# Legal Owl — root .env template (backend / CLI / admin credentials).
# Copy to `.env` (gitignored) and fill real values. NEVER commit `.env`.
# These are server-side/admin only — they must NOT be NEXT_PUBLIC_* and never reach the browser.
# App-runtime vars live in apps/web/.env.local (see apps/web/.env.example).

# ── Supabase project ──────────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_REGION=ap-south-1
# Project API keys (Dashboard → Project Settings → API)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # service-role: data + auth-admin on *.supabase.co
# Direct DB password (Dashboard → Project Settings → Database) — used for migrations (supabase db push)
SUPABASE_DB_PASSWORD=...
# Personal access token (Dashboard → Account → Access Tokens) — Management API: auth URL config, etc.
SUPABASE_ACCESS_TOKEN=sbp_...

# ── Vercel ────────────────────────────────────────────────────────────────────
# Account/team token (vercel.com/account/tokens) — CLI deploy + env management. Scope to the team.
VERCEL_TOKEN=...

# ── External services ─────────────────────────────────────────────────────────
ECOURTS_API_KEY=eci_live_...
RESEND_API_KEY=re_...
